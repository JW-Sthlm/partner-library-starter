# Build-time environment variables.
#
# Copy this file to `.env.local` for local dev (gitignored).
# In CI, set these as GitHub Actions secrets and inject them into the build step.

# Application Insights connection string. When unset, analytics is silently
# disabled and the site still works normally. The full connection string looks
# like: InstrumentationKey=...;IngestionEndpoint=https://...;LiveEndpoint=...
#
# This value is embedded in the built static bundle and is not a privileged
# secret. Treat it like a public identifier.
VITE_APPINSIGHTS_CONNECTION_STRING=
