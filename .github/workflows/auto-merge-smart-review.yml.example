name: Auto-Merge Smart Review PRs

# Auto-approve and merge PRs created by the Smart Review Agent.
# These PRs contain links that have already been QA'd by a human reviewer
# on the issue — the PR is just the formatted addition to the site.

on:
  pull_request:
    types: [opened, ready_for_review]

jobs:
  auto-merge:
    # Only auto-merge PRs from Copilot's smart-review agent
    # Skip drafts — they need to be marked ready first
    if: |
      !github.event.pull_request.draft &&
      (github.event.pull_request.user.login == 'Copilot[bot]' ||
      github.event.pull_request.user.login == 'copilot[bot]' ||
      github.event.pull_request.user.login == 'copilot-swe-agent[bot]' ||
      startsWith(github.event.pull_request.head.ref, 'copilot/'))
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
    steps:
      - name: Auto-approve
        uses: actions/github-script@v7
        with:
          script: |
            // Approve the PR
            await github.rest.pulls.createReview({
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: context.payload.pull_request.number,
              event: 'APPROVE',
              body: '✅ Auto-approved — link already reviewed by domain expert on the issue.'
            });

      - name: Enable auto-merge
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          gh pr merge ${{ github.event.pull_request.number }} \
            --auto --squash \
            --repo ${{ github.repository }}
