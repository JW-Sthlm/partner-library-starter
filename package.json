{
  "name": "partner-library-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter template for a Markdown-driven partner library on VitePress + Azure Static Web Apps, with optional agentic curation loop.",
  "license": "MIT",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run generate-browse-data && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "npm run docs:build",
    "generate-browse-data": "tsx scripts/generate-browse-data.ts",
    "validate-metadata": "tsx scripts/validate-metadata.ts",
    "research": "tsx scripts/research-agent.ts",
    "maintenance": "tsx scripts/maintenance-agent.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.3",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@microsoft/applicationinsights-web": "^3.4.1"
  },
  "overrides": {
    "vite": "7.3.6",
    "esbuild": "0.28.1"
  }
}
